set offparty_kick_key "F8"
set summon_key ""
set summon_cast_seconds 20.0
set summon_cooldown 5.0
set ud_key ""
set ud_cooldown 900.0
set ud_damage_per_second 0.2
set ud_hp_threshold 0.14
set mass_aggro_key ""
set mass_aggro_cast_seconds 1.0
set mass_aggro_cooldown 40.0
set mass_aggro_hp_threshold 0.33
set mass_aggro_damage_per_second 0.15
set support_buff_min_mp 0.8
set support_buff_emergency_hp 0.2
set support_mass_buff_enabled false
set support_mass_buff3_key "NUM3"
set support_mass_buff4_key "NUM4"
set support_mass_buff5_key "NUM5"
set support_mass_buff6_key "NUM6"
