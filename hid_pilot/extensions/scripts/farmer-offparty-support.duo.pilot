# МА + офф-пати саппорт. Запуск с вкладки «Два окна».
# МА: F7 — приглашение, F8 — исключение саппорта из пати.
# Саппорт: F11 и F12 — последовательные баффы; F9 — пати-хил.
# После таймеров баффов или двух секунд хила МА исключает саппорта.
# Дуо-фарм: МА + саппорт.
# START запускается с вкладки «Дуо: МА + саппорт».
# Пати-реген отключается строкой: set support_party_heal_key ""

set humanize true
set next_target "6"
set next_target_near "7"
set attack "3"
set loot "C"
set heal "F1"
set rest "="
set pickup_loot true
set hp_threshold 0.42
set mp_threshold 0.1
set mp_resume 0.9
set attack_delay 1.5
set heal_delay 14.0
set target_delay 0.15
set approach_delay 5.0
set loot_attempts 1
set combat_timeout 90.0
set stuck_timeout 4.0
set progress_epsilon 0.002
set rest_timeout 180.0
set observation_attempts 30
set observation_delay 0.5
set heal_attempts 10
set cycles 10000
set max_hours 9.0
set corpse_key "4"
set corpse_cast_seconds 0.3
set corpse_cooldown 5.0
set hp_elixir_key "NUM2"
set hp_elixir_hp_threshold 0.25
set hp_elixir_cooldown 300.0
set buff_delay_minutes 1.0
set buff_min_hp 0.5
set buff_min_mp 0.1
set aggro_key ""
